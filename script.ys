!python router/export_config.py cpp 'router.memory_mapped_router.Config' > gen/memory_mapped_router_pkg.cpp
!python router/gen_types.py 'router.memory_mapped_router.Flit' > gen/flit.cpp

!python router/fatmeshy_router_top.py > gen/top.il
read_rtlil gen/top.il

hierarchy -top top

setattr -set input_port 1 i:*
setattr -set output_port 1 o:*

# do checks on the input and output ports
design -push-copy
flatten
proc

splitnets -driver; clean -purge; splitnets -driver; clean -purge

# comb feedback on ports is just shit
#shell
# show i:* %coe* o:* %cie* %i
select -assert-none i:* %coe* o:* %cie* %i
design -pop

# flatten to extract debug items
flatten
expose a:debug_item

# split on drivers, this cleans up feedback cycles <-> no longer necessary
# proc
# splitnets -driver; clean -purge; splitnets -driver; clean -purge

#write_verilog /tmp/a.
#-g2
write_cxxrtl -g4 -header gen/router_top.cpp
